# MLOps V3 Pipeline Management API — Environment Variables
# Copy this file to .env and fill in the values.

# API authentication key (required)
API_KEY=

# Azure ML workspace coordinates (required)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_WORKSPACE_NAME=

# Compute target (optional — default: mlopsv2computecluster)
COMPUTE_TARGET=mlopsv2computecluster

# API server (optional)
API_HOST=0.0.0.0
API_PORT=8000
