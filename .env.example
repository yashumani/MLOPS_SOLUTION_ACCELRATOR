# MLOps V3 — Environment Variables
# Copy this file to .env and fill in the values. Never commit .env.

# ── Azure ML workspace coordinates (REQUIRED for every script & submission) ──
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_WORKSPACE_NAME=your-aml-workspace
AZURE_COMPUTE=your-compute-cluster

# ── Optional: state directory for submit lock + audit log + last-job pointer ──
# Defaults to ~/.mlops. Use this on shared submit hosts for per-team isolation.
# MLOPS_STATE_DIR=/var/lib/mlops/state

# ── Pipeline Management API (api/) ──
# Required if you run the management API.
API_KEY=

# Optional API server config
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ── Streamlit UI (ui/) ──
API_BASE_URL=http://localhost:8000
UI_BASE_URL=http://localhost:8501
STREAMLIT_PORT=8501
UI_REFRESH_INTERVAL=30

# ── Drift alerts (Phase 4 — optional) ──
# Microsoft Teams incoming-webhook URL
# DRIFT_TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# Azure Communication Services for email alerts
# DRIFT_ACS_CONNECTION_STRING=endpoint=https://...;accesskey=...
# DRIFT_ALERT_FROM=DoNotReply@your-acs-domain.com
# DRIFT_ALERT_TO=mlops-oncall@your-org.com

# Job notification emails (optional SMTP report delivery)
# The API sends to one configured recipient only. Replace this value when the
# operational owner changes. Defaults below use Gmail SMTP over STARTTLS.
NOTIFICATION_RECIPIENT_EMAIL=mlops-oncall@example.com
NOTIFICATION_SENDER_EMAIL=mlops-notifications@example.com
NOTIFICATION_SMTP_HOST=smtp.gmail.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=mlops-notifications@example.com
# Gmail requires an app password when 2-Step Verification is enabled. Do not
# use or commit your normal Google account password.
NOTIFICATION_SMTP_PASSWORD=<gmail-app-password>
NOTIFICATION_SMTP_STARTTLS=true
NOTIFICATION_SMTP_SSL=false
# NOTIFICATION_REPORT_DIR=outputs/notifications
# NOTIFICATION_MAX_ATTACHMENT_BYTES=5000000
